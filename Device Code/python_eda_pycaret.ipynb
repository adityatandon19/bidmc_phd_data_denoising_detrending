# Initialize setup
clf = setup(data=df, target="heart_disease", session_id=123, silent=True)

# Compare baseline models
best = compare_models()

# Finalize the best model
final_model = finalize_model(best)

# Save model
save_model(final_model, "ppg_cvd_model")
